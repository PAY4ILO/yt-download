{
  "manifest_version": 3,
  "name": "YT Download",
  "version": "1.2.0",
  "key": "",
  "description": "Скачивание видео и звука с YouTube через yt-dlp: кнопка «Скачать» под плеером, качество до 4K/8K, MP3, фрагменты и GIF, плейлисты, обложки.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-download@payk",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging", "storage", "notifications"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "commands": {
    "quick-download": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Скачать текущее видео (или открыть выбор качества)"
    }
  },
  "action": {
    "default_title": "YT Download",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
